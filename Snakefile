# Generated by the reproducible-paper-artefacts skill. Edit freely; the rules
# below are a worked skeleton, not a fixed contract.

from glob import glob
from pathlib import Path
import os
import subprocess
import sys

ART = "paper/artefacts"

# Python scripts import the helpers with `import artefacts`. Snakemake runs each
# script under its own interpreter and puts only the script's folder on
# sys.path, so the helper folder goes on PYTHONPATH here, where `make` and a
# bare `snakemake` both pass. That interpreter is also where a Python rule's
# packages must be installed. Here it is the project environment, .venv, which
# `uv sync` builds from pyproject.toml and uv.lock, and the Makefile runs the
# Snakemake installed there.
os.environ["PYTHONPATH"] = os.pathsep.join(
    p for p in (str(Path("py/lib").resolve()), os.environ.get("PYTHONPATH")) if p
)

# The registry: every artefact the manuscript uses. A name here without a rule
# below fails at once with MissingRuleException, so this list is safe to treat
# as the registry.
NUMBERS = ["kernel-scale",             # the scale of the plain HAR kernel matrix
           "empirical",                # the settings of the estimators and of Table 1
           "fits",                     # the settings of Figure 1
           "depth",                    # the settings of the depth figure
           "biases",                   # Section 4.3: its ratios, edge checks and settings
           "bias-truths",              # the settings of its figure of the truths
           "bias-dimension"]           # its claim 1 with more covariates
FIGURES = ["fits",                     # Figure 1
           "depth",                    # cross-validated error against the depth
           "bias-truths-waves",        # the truths of Section 4.3, one figure
           "bias-truths-rules",        # for each claim
           "bias-truths-density"]
TABLES = ["empirical", "runtime",      # Table 1 (relative test MSE) and the fit times
          "empirical-full",            # the same two tables in the appendix, with
          "runtime-full",              # the additional comparators
          "bias-waves",                # Section 4.3: mean test MSE on each DGP,
          "bias-rules",                # one table for each claim
          "bias-density",
          "bias-dimension"]            # claim 1 with more covariates


def lib(*dirs):
    """Every file under these topic directories, as rule inputs.

    Snakemake's `code` rerun trigger hashes the script file and nothing it
    sources or imports. Change a function in py/lib/kernel_ridge and the script
    hashes the same, so Snakemake reports the artefact as up to date when it is
    not. A false-fresh number is worse than no tracking at all, because it is
    the kind of wrong you stop checking for.

    Declaring the directory fixes that without per-file bookkeeping. New helper
    files are picked up automatically, and invalidation is coarse in the safe
    direction: editing any estimation helper marks every fit stale, and nothing
    that read a file is ever missed.

    The lever on precision is directory structure. If py/lib/estimators is too
    blunt, split it into its files, one for each estimator, as ESTIMATOR_CODE
    below does, and have each rule depend on what it uses.
    """
    out = []
    for d in dirs:
        # A single file is a legitimate argument. Globbing "file.py/**/*" matches
        # nothing, so without this a lib("py/lib/artefacts.py") would silently
        # declare no dependency at all, which is the exact silent
        # under-declaration this helper exists to prevent.
        if Path(d).is_file():
            out.append(d)
            continue
        for f in glob(f"{d}/**/*", recursive=True):
            q = Path(f)
            if not q.is_file():
                continue
            # Compiled bytecode and editor droppings are not source. They also
            # change every time the interpreter runs, so declaring them would
            # mark artefacts stale for no reason and train you to ignore the
            # staleness report.
            if any(part.startswith(".") or part == "__pycache__" for part in q.parts):
                continue
            if q.suffix in {".pyc", ".pyo", ".so", ".o"}:
                continue
            out.append(f)
    return sorted(out)


# Helper code, by topic. Each rule declares what its script imports, and the
# Table 1 rules declare single files, because the fast cells take two hours and
# should not rerun after an edit they do not read.
KRR = lib("py/lib/kernel_ridge")                        # HAR and the other kernel ridge methods
HAL = lib("py/lib/highly_adaptive_regression.py")       # HAL
T1 = "py/lib/table1"
TABLE1_DATA = lib(f"{T1}/__init__.py", f"{T1}/design.py", f"{T1}/data.py")
TABLE1_FIT = TABLE1_DATA + lib(f"{T1}/fit.py")
DEMO = lib("py/lib/sim/__init__.py", "py/lib/sim/design.py", "py/lib/sim/dgps.py", "py/lib/sim/demo.py")
DISPLAY = lib("py/lib/display", "py/lib/artefacts.py")  # summaries, figures and tables

# The estimators of Section 4 and appendix C, one module each in
# py/lib/estimators. Each rule that fits an estimator declares that estimator's
# code and nothing else, so an edit to one estimator reruns only its fits.
# pymars needs a newer scikit-learn than the main environment pins, so the MARS
# fits run under the interpreter of envs/mars, and they declare its lock file.
EST = "py/lib/estimators"
EST_BASE = lib(f"{EST}/__init__.py", f"{EST}/folds.py")
KPATH = EST_BASE + KRR + lib(f"{EST}/kernel_path.py")
ESTIMATOR_CODE = {
    "har": KPATH + lib(f"{EST}/depths.py", f"{EST}/har.py"),
    "mixed_sobolev_depth": KPATH + lib(f"{EST}/depths.py", f"{EST}/sobolev_depth.py",
                                       f"{EST}/mixed_sobolev_depth.py"),
    "hal": EST_BASE + HAL + lib(f"{EST}/hal.py"),
    "gbt": EST_BASE + lib(f"{EST}/gbt.py"),
    "rbf": KPATH + lib(f"{EST}/rbf.py"),
    "mars": EST_BASE + lib(f"{EST}/depths.py", f"{EST}/mars.py", "envs/mars/pyproject.toml",
                           "envs/mars/uv.lock"),
    "rf": EST_BASE + lib(f"{EST}/rf.py"),
    "mlp": EST_BASE + lib(f"{EST}/mlp.py"),
    "enet": EST_BASE + lib(f"{EST}/enet.py"),
}
ESTIMATORS = list(ESTIMATOR_CODE)   # the order of the full tables, PAPER_ALL
MARS_PYTHON = "envs/mars/.venv/bin/python"

# The paper's Section 4: the estimators of the main text, in its order, and all
# of them with the additional comparators of appendix C, with the methods of
# one kind together. The tables put the estimators that penalize sectional
# variation first (HAR, MS-KRR, HAL, boosting), then radial basis KRR, then the
# others, and the elastic net last (author's request, 2026-10-21). Gradient
# boosted trees are in the main text and the random forest in the appendix
# (author's request, 2026-10-15). Figure 1 keeps its panel order
# (FIG_FITS_METHODS).
PAPER_MAIN = ["har", "mixed_sobolev_depth", "hal", "gbt", "rbf", "enet"]
PAPER_ALL = ["har", "mixed_sobolev_depth", "hal", "gbt", "rbf", "mars", "rf", "mlp", "enet"]
FIG_FITS_METHODS = ["har", "mixed_sobolev_depth", "rbf", "hal", "gbt", "enet"]
# The paper's names for the estimators whose module names them otherwise.
PAPER_NAMES = {"mixed_sobolev_depth": "Mixed Sobolev KRR"}


# ---------------------------------------------------------------------------
# The design: which cells exist. The settings inside a cell (seeds, splits,
# learners) are in py/lib, where a change reruns the cells that read them.

DATA = "data/uci"   # the UCI csv files; data/README.md says where they come from

# Table 1, with the datasets in the order of the paper's rows.
TABLE1_DATASETS = [
    "power", "yacht", "concrete", "energy", "kin8nm", "protein",
    "wine", "boston", "naval", "yearmsd", "slice",
]
TABLE1_REPS = list(range(5))
# The fits that are not run. HAL's implementation handles at most 63
# covariates.
TABLE1_SKIP = {("yearmsd", "hal"), ("slice", "hal")}


def fits_of(methods):
    """The (dataset, method) cells of Table 1 for these methods, less the skipped ones."""
    return [(d, m) for d in TABLE1_DATASETS for m in methods if (d, m) not in TABLE1_SKIP]


PAPER_FITS = fits_of(PAPER_ALL)     # what the paper's tables read


def table1_files(kind):
    """The result or tuning file of every Table 1 fit that the paper's tables read."""
    suffix = "" if kind == "result" else "-tuning"
    return [f"results/table1/{d}/{m}/rep{r}{suffix}.csv" for d, m in PAPER_FITS for r in TABLE1_REPS]


# Every job runs on one thread: the linear algebra (Accelerate, OpenBLAS, MKL),
# OpenMP and numba. Jobs run in parallel, one to a core, so the time of each
# fit is the time of one core, and the times of the estimators compare.
for _v in ["VECLIB_MAXIMUM_THREADS", "OPENBLAS_NUM_THREADS", "MKL_NUM_THREADS",
           "OMP_NUM_THREADS", "NUMBA_NUM_THREADS"]:
    os.environ[_v] = "1"

wildcard_constraints:
    dataset=r"[a-z0-9]+",
    method=r"[a-z0-9_]+",
    rep=r"\d+",
    dgp=r"[a-z]+",


onstart:
    # The Makefile already ran this, with a friendlier message. Running it again
    # here is what closes the bypass: a bare `snakemake` gets guarded too. With
    # no tier given the strictest one applies, so the bypass fails closed.
    tier = config.get("tier", "paper")
    result = subprocess.run(
        [sys.executable, "tools/build_guard.py", "--tier", tier],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        sys.exit(result.stdout + result.stderr)


onsuccess:
    # Collapse the per-rule provenance sidecars into BUILD.json. It lives here
    # rather than in the Makefile so that a bare `snakemake` produces exactly
    # the same result, which leaves `make` as convenience rather than as a step
    # you can forget.
    subprocess.run([sys.executable, "tools/record_provenance.py", "--merge"])


onerror:
    # A build that fails part way has still written some artefacts, and
    # BUILD.json should describe them.
    subprocess.run([sys.executable, "tools/record_provenance.py", "--merge"])


rule all:
    input:
        expand(f"{ART}/numbers/{{u}}.tex", u=NUMBERS),
        expand(f"{ART}/figures/{{f}}.pdf", f=FIGURES),
        expand(f"{ART}/tables/{{t}}.tex", t=TABLES),
        *([f"{ART}/artefacts.tex"] if NUMBERS else []),


# No rule builds a notes artefact any more. The notes' artefacts were built on
# their wip branches, whose commits still exist, so their stamps hold. The rule
# stays because the checkers (tools/artefact_status.py and tools/check_deps.py)
# dry-run `all notes`, and `make notes` builds it. Its input is this file and
# nothing else: a target with neither input nor output is scheduled on every
# run, and one with an existing input and no output is not.
rule notes:
    input:
        "Snakefile",


rule artefacts_tex:
    """One \\input line for main.tex, regenerated as numbers come and go.

    The preamble says \\input{artefacts/artefacts.tex} once and never changes.
    """
    input:
        expand(f"{ART}/numbers/{{u}}.tex", u=NUMBERS),
    output:
        f"{ART}/artefacts.tex",
    run:
        lines = ["% Generated. Do not edit.", ""]
        lines += ["\\input{artefacts/numbers/%s}" % Path(p).name for p in sorted(input)]
        Path(output[0]).write_text("\n".join(lines) + "\n")


# ---------------------------------------------------------------------------
# Table 1 (tab:empirical) and the fit times (tab:runtime): nine estimators on
# eleven UCI datasets. Each fit is one job, on one thread: one estimator, one
# dataset and one repetition. The fits write results/, and the tables read it,
# so a change to a table's format reruns no fit, and a change to one
# estimator reruns only its fits.

# The fit rules run their scripts from a shell command, so that the MARS fits
# can run under the interpreter of envs/mars. Snakemake hashes a shell command
# and not the script that it calls, so each rule declares its script as an
# input. The jobs get PYTHONPATH and the thread settings from os.environ above.

def _python(wc):
    """The interpreter of an estimator's fits."""
    return MARS_PYTHON if wc.method == "mars" else sys.executable


rule table1_fit:
    input:
        data=f"{DATA}/{{dataset}}.csv",
        code="py/table1_fit.py",
        helpers=lambda wc: ESTIMATOR_CODE[wc.method] + TABLE1_FIT,
    output:
        result="results/table1/{dataset}/{method}/rep{rep}.csv",
        tuning="results/table1/{dataset}/{method}/rep{rep}-tuning.csv",
    wildcard_constraints:
        method="|".join(ESTIMATORS),
    params:
        python=_python,
    threads: 1
    shell:
        "{params.python} py/table1_fit.py {input.data} {wildcards.dataset} {wildcards.method}"
        " {wildcards.rep} {output.result} {output.tuning}"


rule table_empirical:
    input:
        results=table1_files("result"),
        tunings=table1_files("tuning"),
        helpers=DISPLAY,
    output:
        mse=f"{ART}/tables/empirical.tex",
        runtime=f"{ART}/tables/runtime.tex",
        mse_full=f"{ART}/tables/empirical-full.tex",
        runtime_full=f"{ART}/tables/runtime-full.tex",
        numbers=f"{ART}/numbers/empirical.tex",
    params:
        datasets=TABLE1_DATASETS,
        main=PAPER_MAIN,
        methods=PAPER_ALL,
        names=PAPER_NAMES,
    script: "py/table_empirical.py"


# ---------------------------------------------------------------------------
# The depth figure (fig:depth): the cross-validated error of HAR and of mixed
# Sobolev KRR at every depth of the depth path, with no early stopping, on the
# training part and the folds of each Table 1 fit. One job per dataset, method
# and repetition, on one thread. It fits the estimator's own code with its
# patience removed, so each curve is the one that the early-stopped walk of the
# Table 1 fit follows until it stops.

DEPTH_CURVE_METHODS = ["har", "mixed_sobolev_depth"]


rule depth_curve:
    input:
        data=f"{DATA}/{{dataset}}.csv",
        helpers=lambda wc: ESTIMATOR_CODE[wc.method] + TABLE1_DATA,
    output:
        "results/depth/{dataset}/{method}/rep{rep}.csv",
    wildcard_constraints:
        method="|".join(DEPTH_CURVE_METHODS),
    threads: 1
    script: "py/depth_curve.py"


# The curves of the two widest datasets take the longest, so their jobs start first.
use rule depth_curve as depth_curve_wide with:
    wildcard_constraints:
        dataset="slice|yearmsd",
        method="|".join(DEPTH_CURVE_METHODS),
    priority: 10

ruleorder: depth_curve_wide > depth_curve


rule fig_depth:
    input:
        curves=expand("results/depth/{dataset}/{method}/rep{rep}.csv", dataset=TABLE1_DATASETS,
                      method=DEPTH_CURVE_METHODS, rep=TABLE1_REPS),
        helpers=DISPLAY,
    output:
        figure=f"{ART}/figures/depth.pdf",
        numbers=f"{ART}/numbers/depth.tex",
    params:
        datasets=TABLE1_DATASETS,
        methods=DEPTH_CURVE_METHODS,
        names=PAPER_NAMES,
    script: "py/fig_depth.py"


# ---------------------------------------------------------------------------
# The scale of the plain HAR kernel matrix (Section "Sectional Weights"): its
# largest, smallest and largest off-diagonal elements for one draw of
# Unif([0,1]^200) points. It builds one kernel, in seconds. The script imports
# the kernels through the package, so it reads these files and no others.

rule kernel_scale:
    input:
        helpers=lib(
            "py/lib/kernel_ridge/__init__.py", "py/lib/kernel_ridge/kernel_ridge.py",
            "py/lib/kernel_ridge/kernels.py", "py/lib/kernel_ridge/timer.py",
            "py/lib/artefacts.py",
        ),
    output:
        f"{ART}/numbers/kernel-scale.tex",
    script: "py/kernel_scale.py"


# ---------------------------------------------------------------------------
# Figure 1 (fig:fits): the fits of the estimators of the main text on
# one-dimensional data. Each estimator is one job.

rule sim_fits:
    input:
        code="py/sim_fits.py",
        helpers=lambda wc: ESTIMATOR_CODE[wc.method] + DEMO,
    output:
        "results/fits/{method}.csv",
    wildcard_constraints:
        method="|".join(ESTIMATORS),
    params:
        python=_python,
    threads: 1
    shell:
        "{params.python} py/sim_fits.py {wildcards.method} {output}"


rule fig_fits:
    input:
        predictions=expand("results/fits/{method}.csv", method=FIG_FITS_METHODS),
        helpers=DISPLAY,
    output:
        figure=f"{ART}/figures/fits.pdf",
        numbers=f"{ART}/numbers/fits.tex",
    params:
        methods=FIG_FITS_METHODS,
        names=PAPER_NAMES,
    script: "py/fig_fits.py"


# ---------------------------------------------------------------------------
# Section 4.3 (tab:bias-waves, tab:bias-rules, tab:bias-density, and the
# figures of the truths, fig:bias-truths-waves, -rules and -density): the simulation that tests the inductive biases of Section
# 3.4, with the estimators of Section 4.1 that its claims name, tuned as there.
# Each cell is one estimator on one DGP over a block of BIAS_BLOCK repetitions,
# on one thread, and declares only its estimator's code, so an edit to one
# estimator reruns only its cells. The cells write results/biases/, and the
# tables (one for each claim) and the numbers read it. The DGPs and their
# settings are in py/lib/biases.

BIAS_DGPS = ["wave1", "wave2", "wave3", "wave4", "rules", "ramps", "dense", "sparse", "flipped"]
BIAS_METHODS = ["har", "mixed_sobolev_depth", "hal", "gbt", "rbf"]
BIAS_REPS = 200
BIAS_BLOCK = 10
BIAS_BLOCKS = list(range(BIAS_REPS // BIAS_BLOCK))
# The edge checks of appendix C: each variant of biases/variants.py, an
# estimator with one grid extended, on the DGPs where the pilot found that
# estimator at the edge of the grid.
BIAS_EDGE = {"rbf_wide": ["wave1"], "gbt_deep": ["wave3", "wave4"]}

BIAS_DGP_CODE = lib("py/lib/biases/__init__.py", "py/lib/biases/design.py", "py/lib/biases/dgps.py")
BIAS_CELL = BIAS_DGP_CODE + lib("py/lib/biases/cell.py")
BIAS_EDGE_CODE = (ESTIMATOR_CODE["rbf"] + ESTIMATOR_CODE["gbt"] + BIAS_CELL
                  + lib("py/lib/biases/variants.py"))


def _bias_reps(wc):
    b = int(wc.block)
    return list(range(b * BIAS_BLOCK, (b + 1) * BIAS_BLOCK))


def bias_files(kind):
    """The result or tuning file of every cell of the simulation and of its edge checks."""
    suffix = "" if kind == "result" else "-tuning"
    cells = [(d, m) for d in BIAS_DGPS for m in BIAS_METHODS]
    cells += [(d, v) for v, ds in BIAS_EDGE.items() for d in ds]
    return [f"results/biases/{d}/{m}/block{b}{suffix}.csv" for d, m in cells for b in BIAS_BLOCKS]


rule bias_cell:
    input:
        helpers=lambda wc: ESTIMATOR_CODE[wc.method] + BIAS_CELL,
    output:
        result="results/biases/{dgp}/{method}/block{block}.csv",
        tuning="results/biases/{dgp}/{method}/block{block}-tuning.csv",
    wildcard_constraints:
        dgp="|".join(BIAS_DGPS),
        method="|".join(BIAS_METHODS),
        block=r"\d+",
    params:
        reps=_bias_reps,
    threads: 1
    script: "py/bias_cell.py"


rule bias_edge:
    input:
        helpers=BIAS_EDGE_CODE,
    output:
        result="results/biases/{dgp}/{variant}/block{block}.csv",
        tuning="results/biases/{dgp}/{variant}/block{block}-tuning.csv",
    wildcard_constraints:
        dgp="|".join(BIAS_DGPS),
        variant="|".join(BIAS_EDGE),
        block=r"\d+",
    params:
        reps=_bias_reps,
    threads: 1
    script: "py/bias_edge.py"


rule table_biases:
    input:
        results=bias_files("result"),
        tunings=bias_files("tuning"),
        helpers=DISPLAY + BIAS_EDGE_CODE + lib("py/lib/biases/summary.py", "py/lib/biases/report.py"),
    output:
        waves=f"{ART}/tables/bias-waves.tex",
        rules=f"{ART}/tables/bias-rules.tex",
        density=f"{ART}/tables/bias-density.tex",
        numbers=f"{ART}/numbers/biases.tex",
    params:
        dgps=BIAS_DGPS,
        methods=BIAS_METHODS,
        names=PAPER_NAMES,
    script: "py/table_biases.py"


rule fig_bias_truths:
    input:
        helpers=BIAS_DGP_CODE + lib("py/lib/biases/figures.py", "py/lib/artefacts.py"),
    output:
        waves=f"{ART}/figures/bias-truths-waves.pdf",
        rules=f"{ART}/figures/bias-truths-rules.pdf",
        density=f"{ART}/figures/bias-truths-density.pdf",
        numbers=f"{ART}/numbers/bias-truths.tex",
    script: "py/fig_bias_truths.py"


# Claim 1 of Section 4.3 with more covariates (tab:bias-dimension): the wave
# along two covariates, copied onto every pair of p covariates
# (biases/copies.py), with the estimators of Section 4.3 but HAL. Cells as in
# bias_cell, writing results/bias-copies/.
# biases/copies.py has its own run function, so that the cells of Section 4.3,
# which declare biases/cell.py and biases/dgps.py, do not rerun.
COPIES_DGPS = [f"copies{p}" for p in (4, 8, 12, 16, 24)]
COPIES_METHODS = ["har", "mixed_sobolev_depth", "gbt", "rbf"]
COPIES_REPS = 200
COPIES_BLOCKS = list(range(COPIES_REPS // BIAS_BLOCK))
COPIES_CELL = BIAS_CELL + lib("py/lib/biases/copies.py")


def copies_files(kind):
    suffix = "" if kind == "result" else "-tuning"
    return [f"results/bias-copies/{d}/{m}/block{b}{suffix}.csv"
            for d in COPIES_DGPS for m in COPIES_METHODS for b in COPIES_BLOCKS]


rule copies_cell:
    input:
        helpers=lambda wc: ESTIMATOR_CODE[wc.method] + COPIES_CELL,
    output:
        result="results/bias-copies/{dgp}/{method}/block{block}.csv",
        tuning="results/bias-copies/{dgp}/{method}/block{block}-tuning.csv",
    wildcard_constraints:
        dgp="|".join(COPIES_DGPS),
        method="|".join(COPIES_METHODS),
        block=r"\d+",
    params:
        reps=_bias_reps,
    threads: 1
    script: "py/copies_cell.py"


rule table_bias_dimension:
    input:
        results=copies_files("result"),
        helpers=DISPLAY + lib("py/lib/biases/__init__.py", "py/lib/biases/design.py",
                              "py/lib/biases/summary.py", "py/lib/biases/report.py",
                              "py/lib/biases/copies_display.py"),
    output:
        table=f"{ART}/tables/bias-dimension.tex",
        numbers=f"{ART}/numbers/bias-dimension.tex",
    params:
        methods=COPIES_METHODS,
        names=PAPER_NAMES,
    script: "py/table_bias_dimension.py"
